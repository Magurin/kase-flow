{
  "name": "kase-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"node server/index.mjs\" \"vite --host 127.0.0.1\"",
    "build": "tsc -b && vite build",
    "start": "node server/index.mjs",
    "chain:build": "cargo build-sbf --manifest-path program/Cargo.toml",
    "test": "node --test --test-concurrency=1 tests/*.test.mjs",
    "test:program": "cargo build-sbf --manifest-path program/Cargo.toml && cargo test --manifest-path program/Cargo.toml",
    "package": "node scripts/package.mjs",
    "devnet:deploy": "node scripts/devnet.mjs",
    "dev:devnet": "node scripts/devnet.mjs --serve",
    "test:e2e": "node scripts/e2e.mjs",
    "test:wallet": "node scripts/wallet-e2e.mjs",
    "rpc:check": "node scripts/check-rpc.mjs",
    "test:chain": "node scripts/verify-devnet.mjs",
    "test:security": "node --test tests/devnet/*.mjs",
    "test:workspace": "node scripts/verify-workspace.mjs"
  },
  "dependencies": {
    "@fontsource-variable/golos-text": "^5.3.0",
    "@radix-ui/react-select": "^2.3.7",
    "@solana/spl-token": "^0.4.14",
    "@solana/web3.js": "^1.98.4",
    "bigint-buffer": "file:./vendor/bigint-buffer",
    "buffer": "^6.0.3",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "playwright": "^1.51.0",
    "prettier": "^3.9.9",
    "typescript": "~5.7.2",
    "vite": "^6.1.0"
  },
  "overrides": {
    "jayson": "5.0.0"
  }
}
